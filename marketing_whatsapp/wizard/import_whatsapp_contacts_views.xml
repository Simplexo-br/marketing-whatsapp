<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_import_whatsapp_contacts_form" model="ir.ui.view">
        <field name="name">wizard.import.whatsapp.contacts.form</field>
        <field name="model">wizard.import.whatsapp.contacts</field>
        <field name="arch" type="xml">
            <form string="Importar Planilha de Contatos (WhatsApp)">
                <sheet>
                    <div class="oe_title">
                        <h2>Importador Rápido de Planilha de Disparo</h2>
                        <p class="text-muted">Carregue um arquivo .CSV com os dados dos seus contatos. Os números serão automaticamente convertidos para o formato internacional E.164 com proteção contra duplicidades.</p>
                    </div>
                    <group>
                        <group string="Arquivo &amp; Destino">
                            <field name="file" filename="file_name" widget="binary"/>
                            <field name="file_name" invisible="1"/>
                            <field name="mailing_list_id" options="{'no_create': False}"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="update_existing"/>
                        </group>
                        <group string="Mapeamento de Colunas (Cabeçalhos)">
                            <field name="column_name"/>
                            <field name="column_company"/>
                            <field name="column_phone"/>
                            <field name="column_var1"/>
                            <field name="column_var2"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Importar Contatos" type="object" name="action_import_contacts" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_whatsapp_contacts" model="ir.actions.act_window">
        <field name="name">Importar Planilha para WhatsApp</field>
        <field name="res_model">wizard.import.whatsapp.contacts</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
