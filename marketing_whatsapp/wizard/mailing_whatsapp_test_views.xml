<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_mailing_whatsapp_test_form" model="ir.ui.view">
        <field name="name">wizard.mailing.whatsapp.test.form</field>
        <field name="model">wizard.mailing.whatsapp.test</field>
        <field name="arch" type="xml">
            <form string="Enviar Teste de WhatsApp">
                <sheet>
                    <div class="oe_title">
                        <h3>Disparo de Prévia da Campanha</h3>
                        <p class="text-muted">Envie uma mensagem de teste diretamente para seu smartphone para validar a formatação, imagens e botões antes de liberar o disparo em massa.</p>
                    </div>
                    <group>
                        <group string="Destinatário do Teste">
                            <field name="mailing_id" invisible="1"/>
                            <field name="whatsapp_account_id" invisible="1"/>
                            <field name="whatsapp_template_id" invisible="1"/>
                            <field name="test_phone_number" placeholder="Ex: +55 11 99999-8888 ou 11999998888"/>
                        </group>
                        <group string="Valores de Simulação">
                            <field name="test_contact_name"/>
                            <field name="test_company_name"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Enviar Mensagem de Teste" type="object" name="action_send_test" class="btn-success"/>
                    <button string="Fechar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
