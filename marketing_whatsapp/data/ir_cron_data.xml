<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron de Disparo em Fila com Pacing Anti-Ban -->
        <record id="ir_cron_whatsapp_mailing_queue" model="ir.cron">
            <field name="name">Marketing WhatsApp: Processador de Fila de Disparo (Anti-Ban)</field>
            <field name="model_id" ref="model_mailing_mailing"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_whatsapp_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron de Faturamento Recorrente e Renovação de Quotas -->
        <record id="ir_cron_whatsapp_subscription_billing" model="ir.cron">
            <field name="name">Marketing WhatsApp: Faturamento Recorrente e Renovação de Assinaturas</field>
            <field name="model_id" ref="model_whatsapp_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_recurring_subscription_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
