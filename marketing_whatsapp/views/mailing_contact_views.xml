<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Mailing Contact Search View with SearchPanel (Filtro Lateral) -->
    <record id="view_mailing_contact_search_whatsapp" model="ir.ui.view">
        <field name="name">mailing.contact.search.whatsapp</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="WhatsApp: Enviados" name="filter_wa_sent" domain="[('wa_status_sent', '=', True)]"/>
                <filter string="WhatsApp: Visualizados (Lidos)" name="filter_wa_read" domain="[('wa_status_read', '=', True)]"/>
                <filter string="WhatsApp: Respondidos" name="filter_wa_replied" domain="[('wa_status_replied', '=', True)]"/>
                <filter string="WhatsApp: Opt-Out (Respondeu 2 / Sair)" name="filter_wa_opt_out" domain="[('wa_status_opt_out', '=', True)]"/>
                <filter string="WhatsApp: Não Enviados" name="filter_wa_not_sent" domain="[('wa_status_sent', '=', False)]"/>
                <searchpanel>
                    <field name="list_ids" icon="fa-users" text="name" enable_counters="1" select="multi" string="Listas de Disparo"/>
                    <field name="wa_status" icon="fa-whatsapp" enable_counters="1" select="one" string="Status WhatsApp"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <!-- Extend Mailing Contact List (Tree View) com Status de Envio, Leitura, Resposta e Opt-Out -->
    <record id="view_mailing_contact_tree_whatsapp" model="ir.ui.view">
        <field name="name">mailing.contact.tree.whatsapp</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="company_name" optional="show"/>
                <field name="mobile_whatsapp" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='create_date']" position="before">
                <field name="wa_status" widget="badge"
                       decoration-muted="wa_status == 'not_sent'"
                       decoration-info="wa_status in ('sent', 'delivered')"
                       decoration-warning="wa_status == 'read'"
                       decoration-success="wa_status == 'replied'"
                       decoration-danger="wa_status == 'opt_out'"
                       string="Status WhatsApp"/>
                <field name="wa_status_sent" string="Enviado" widget="boolean" optional="show"/>
                <field name="wa_status_read" string="Visualizado" widget="boolean" optional="show"/>
                <field name="wa_status_replied" string="Respondido (1)" widget="boolean" optional="show"/>
                <field name="wa_status_opt_out" string="Opt-Out (2)" widget="boolean" optional="show"/>
                <field name="wa_sent_date" string="Data Envio" optional="hide"/>
                <field name="wa_read_date" string="Data Leitura" optional="hide"/>
                <field name="wa_replied_date" string="Data Resposta" optional="hide"/>
                <field name="wa_opt_out_date" string="Data Opt-Out" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Mailing Contact Form -->
    <record id="view_mailing_contact_form_whatsapp" model="ir.ui.view">
        <field name="name">mailing.contact.form.whatsapp</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="mobile_whatsapp"/>
                <field name="company_name"/>
            </xpath>
            <xpath expr="//group[last()]" position="after">
                <group string="Status e Rastreamento WhatsApp">
                    <group>
                        <field name="wa_status" widget="badge"/>
                        <field name="wa_status_sent"/>
                        <field name="wa_status_delivered"/>
                        <field name="wa_status_read"/>
                        <field name="wa_status_replied"/>
                        <field name="wa_status_opt_out"/>
                    </group>
                    <group>
                        <field name="wa_sent_date"/>
                        <field name="wa_read_date"/>
                        <field name="wa_replied_date"/>
                        <field name="wa_opt_out_date"/>
                        <field name="wa_last_response"/>
                    </group>
                </group>
                <group string="Variáveis Customizadas de WhatsApp (Planilha)">
                    <field name="custom_var1"/>
                    <field name="custom_var2"/>
                    <field name="custom_var3"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
