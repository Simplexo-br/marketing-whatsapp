<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Mailing Contact Form -->
    <record id="view_mailing_contact_form_whatsapp" model="ir.ui.view">
        <field name="name">mailing.contact.form.whatsapp</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="mobile_whatsapp"/>
                <field name="company_name"/>
            </xpath>
            <xpath expr="//group[last()]" position="after">
                <group string="Variáveis Customizadas de WhatsApp (Planilha)">
                    <field name="custom_var1"/>
                    <field name="custom_var2"/>
                    <field name="custom_var3"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Mailing Contact List -->
    <record id="view_mailing_contact_tree_whatsapp" model="ir.ui.view">
        <field name="name">mailing.contact.tree.whatsapp</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="company_name" optional="show"/>
                <field name="mobile_whatsapp" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
