<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Marketing WhatsApp" string="Marketing WhatsApp" name="marketing_whatsapp" groups="marketing_whatsapp.group_marketing_whatsapp_manager">
                    <block title="Meta Cloud API (Aplicativo AIOS)" id="whatsapp_meta_api_settings">
                        <setting id="whatsapp_default_account" string="Conta Padrão de Disparo" help="Selecione a conta oficial do WhatsApp Business que será usada para as campanhas.">
                            <field name="whatsapp_default_account_id"/>
                        </setting>
                        <setting id="whatsapp_api_version" string="Versão da Graph API" help="Versão da API da Meta (recomendado v20.0).">
                            <field name="whatsapp_api_version"/>
                        </setting>
                        <setting id="whatsapp_webhook_token" string="Token de Verificação do Webhook" help="Token para verificação do webhook no painel Meta for Developers.">
                            <field name="whatsapp_webhook_verify_token"/>
                        </setting>
                    </block>

                    <block title="Motor Anti-Ban &amp; Pacing" id="whatsapp_antiban_settings">
                        <setting id="whatsapp_batch_size" string="Tamanho do Lote por Execução" help="Quantidade máxima de mensagens enviadas a cada ciclo de cron.">
                            <field name="whatsapp_batch_size"/>
                        </setting>
                        <setting id="whatsapp_delay" string="Intervalo entre Mensagens (segundos)" help="Pausa entre requisições para evitar picos de vazão (Throughput MPS).">
                            <field name="whatsapp_delay_between_messages"/>
                        </setting>
                        <setting id="whatsapp_auto_blacklist" string="Auto-Blacklist em Opt-Out" help="Adicionar automaticamente contatos que responderem 'SAIR' / 'STOP' à lista de bloqueio.">
                            <field name="whatsapp_auto_blacklist_on_stop"/>
                        </setting>
                    </block>

                    <block title="⏰ Janela de Disparo Comercial (08:00 às 17:00)" id="whatsapp_dispatch_window_block">
                        <setting id="whatsapp_window_enabled" string="Ativar Janela Comercial de Disparos" help="Se ativado, campanhas e filas de WhatsApp só enviarão mensagens dentro do horário permitido.">
                            <field name="whatsapp_dispatch_window_enabled"/>
                        </setting>
                        <setting id="whatsapp_window_start" string="Horário de Início (Manhã)" help="Horário que os disparos começam (padrão: 8 = 08:00)." invisible="not whatsapp_dispatch_window_enabled">
                            <field name="whatsapp_dispatch_window_start"/>
                        </setting>
                        <setting id="whatsapp_window_end" string="Horário de Término (Fim da Tarde)" help="Horário que os disparos são interrompidos até o dia seguinte (padrão: 17 = 17:00)." invisible="not whatsapp_dispatch_window_enabled">
                            <field name="whatsapp_dispatch_window_end"/>
                        </setting>
                        <setting id="whatsapp_window_tz" string="Fuso Horário dos Disparos" help="Fuso horário de referência para a janela (ex: America/Sao_Paulo)." invisible="not whatsapp_dispatch_window_enabled">
                            <field name="whatsapp_dispatch_timezone"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_whatsapp_configuration" model="ir.actions.act_window">
        <field name="name">Configurações</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'marketing_whatsapp'}</field>
    </record>
</odoo>
