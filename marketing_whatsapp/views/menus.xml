<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level App Menu -->
    <menuitem id="marketing_whatsapp_root"
              name="Marketing WhatsApp"
              web_icon="marketing_whatsapp,static/description/icon.png"
              sequence="116"
              groups="group_marketing_whatsapp_user"/>

    <!-- Dashboard Geral -->
    <menuitem id="menu_whatsapp_dashboard"
              name="Dashboard"
              parent="marketing_whatsapp_root"
              action="action_whatsapp_dashboard"
              sequence="1"/>

    <!-- Campanhas -->
    <menuitem id="menu_whatsapp_campaigns"
              name="Campanhas"
              parent="marketing_whatsapp_root"
              sequence="10"/>


    <menuitem id="menu_whatsapp_mailing_all"
              name="Campanhas de WhatsApp"
              parent="menu_whatsapp_campaigns"
              action="action_mailing_mailing_whatsapp"
              sequence="1"/>

    <!-- Listas & Contatos -->
    <menuitem id="menu_whatsapp_audiences"
              name="Listas de Contatos"
              parent="marketing_whatsapp_root"
              sequence="20"/>

    <menuitem id="menu_whatsapp_mailing_lists"
              name="Listas de Disparo"
              parent="menu_whatsapp_audiences"
              action="mass_mailing.action_view_mass_mailing_lists"
              sequence="1"/>

    <menuitem id="menu_whatsapp_mailing_contacts"
              name="Todos os Contatos"
              parent="menu_whatsapp_audiences"
              action="mass_mailing.action_view_mass_mailing_contacts"
              sequence="2"/>

    <menuitem id="menu_whatsapp_import_wizard"
              name="Importar Planilha (.CSV / .XLSX)"
              parent="menu_whatsapp_audiences"
              action="action_wizard_import_whatsapp_contacts"
              sequence="3"/>

    <!-- Templates -->
    <menuitem id="menu_whatsapp_templates"
              name="Templates WhatsApp"
              parent="marketing_whatsapp_root"
              action="action_whatsapp_template_tree"
              sequence="30"/>

    <!-- 📱 Canais & WhatsApp Seguro (Inclusão de Novos Números / Instâncias) -->
    <menuitem id="menu_whatsapp_channels_root"
              name="Canais &amp; Números"
              parent="marketing_whatsapp_root"
              sequence="32"/>

    <menuitem id="menu_whatsapp_channels_list"
              name="Canais &amp; WhatsApp Seguro"
              parent="menu_whatsapp_channels_root"
              action="simplexo_aios_whatsapp.action_aios_whatsapp_channels"
              sequence="1"/>

    <menuitem id="menu_whatsapp_accounts_meta"
              name="Contas de WhatsApp (Meta Cloud API)"
              parent="menu_whatsapp_channels_root"
              action="action_whatsapp_account"
              sequence="2"/>

    <!-- 💳 Planos & Assinaturas (Comercialização Simplexo) -->
    <menuitem id="menu_whatsapp_subscriptions_root"
              name="Planos &amp; Faturamento"
              parent="marketing_whatsapp_root"
              sequence="35"
              groups="group_marketing_whatsapp_manager"/>

    <menuitem id="menu_whatsapp_subscriptions_list"
              name="Assinaturas de Clientes"
              parent="menu_whatsapp_subscriptions_root"
              action="action_whatsapp_subscription"
              sequence="1"/>

    <menuitem id="menu_whatsapp_plans_list"
              name="Planos de Assinatura"
              parent="menu_whatsapp_subscriptions_root"
              action="action_whatsapp_subscription_plan"
              sequence="2"/>

    <!-- Relatórios & Entregas -->
    <menuitem id="menu_whatsapp_reporting"
              name="Relatórios"
              parent="marketing_whatsapp_root"
              sequence="40"
              groups="group_marketing_whatsapp_manager"/>

    <menuitem id="menu_whatsapp_traces"
              name="Rastreamento de Entregas"
              parent="menu_whatsapp_reporting"
              action="mass_mailing.mailing_trace_action"
              sequence="1"/>

    <menuitem id="menu_whatsapp_phone_blacklist"
              name="Telefones em Blacklist (Opt-Out)"
              parent="menu_whatsapp_reporting"
              action="phone_validation.phone_blacklist_action"
              sequence="2"/>

    <!-- Configurações -->
    <menuitem id="menu_whatsapp_configuration"
              name="Configurações"
              parent="marketing_whatsapp_root"
              sequence="100"/>

    <menuitem id="menu_whatsapp_channels_config"
              name="Canais &amp; WhatsApp Seguro (Novos Números)"
              parent="menu_whatsapp_configuration"
              action="simplexo_aios_whatsapp.action_aios_whatsapp_channels"
              sequence="1"/>

    <menuitem id="menu_whatsapp_accounts"
              name="Contas de WhatsApp (Meta)"
              parent="menu_whatsapp_configuration"
              action="action_whatsapp_account"
              sequence="2"/>

    <menuitem id="menu_whatsapp_general_settings"
              name="Ajustes Gerais &amp; Anti-Ban"
              parent="menu_whatsapp_configuration"
              action="action_whatsapp_configuration"
              sequence="3"/>
</odoo>

