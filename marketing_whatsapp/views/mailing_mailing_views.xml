<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Mailing Form View -->
    <record id="view_mailing_mailing_whatsapp_form" model="ir.ui.view">
        <field name="name">mailing.mailing.whatsapp.form</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <form string="Campanha de WhatsApp">
                <header>
                    <button name="action_send_whatsapp_now" string="Enviar Agora" type="object" class="btn-primary" invisible="state not in ['draft', 'in_queue']" confirm="Deseja iniciar o envio desta campanha para todos os contatos válidos da lista?"/>
                    <button name="action_put_in_queue" string="Colocar na Fila de Disparo" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_test_whatsapp" string="Enviar Teste para Celular" type="object" class="btn-info" icon="fa-mobile"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state not in ['in_queue', 'sending']"/>
                    <button name="action_retry_failed" string="Reenviar Falhas" type="object" class="btn-warning" invisible="state != 'done' or whatsapp_failed_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_queue,sending,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(mass_mailing.mailing_trace_action)d" icon="fa-paper-plane-o" context="{'search_default_mass_mailing_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total"/></span>
                                <span class="o_stat_text">Total</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-check text-success">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="whatsapp_delivered_count"/></span>
                                <span class="o_stat_text">Entregues</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-eye text-primary">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="whatsapp_read_count"/></span>
                                <span class="o_stat_text">Lidos</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-triangle text-danger" invisible="whatsapp_failed_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="whatsapp_failed_count"/></span>
                                <span class="o_stat_text">Falhas</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="subject" string="Título da Campanha"/>
                        <h1>
                            <field name="subject" placeholder="Ex: Oferta Especial de Primavera - WhatsApp"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuração de Envio">
                            <field name="mailing_type" invisible="1"/>
                            <field name="whatsapp_account_id" required="1" options="{'no_create': True}"/>
                            <field name="whatsapp_template_id" required="1" options="{'no_create': True}"/>
                            <field name="whatsapp_header_media_type" invisible="1"/>
                        </group>
                        <group string="Público-Alvo &amp; Destinatários">
                            <field name="mailing_model_id" string="Enviar Para" widget="radio" options="{'horizontal': true}"/>
                            <field name="contact_list_ids" widget="many2many_tags" invisible="mailing_model_name != 'mailing.list'"/>
                            <field name="mailing_domain" widget="domain" options="{'model': 'mailing_model_name'}" invisible="mailing_model_name == 'mailing.list'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Conteúdo &amp; Mídia" name="content">
                            <div class="row">
                                <div class="col-md-7">
                                    <group string="Mídia do Cabeçalho" invisible="whatsapp_header_media_type == 'none'">
                                        <field name="whatsapp_media_attachment_id" filename="whatsapp_media_url" widget="binary" invisible="whatsapp_header_media_type == 'none'"/>
                                        <field name="whatsapp_media_url" placeholder="https://seu-dominio.com/imagem.jpg" invisible="whatsapp_header_media_type == 'none'"/>
                                    </group>

                                    <group string="Mapeamento de Variáveis Dinâmicas">
                                        <field name="whatsapp_var1_field" string="Valor da Variável {{1}}"/>
                                        <field name="whatsapp_var2_field" string="Valor da Variável {{2}}"/>
                                        <field name="whatsapp_var3_field" string="Valor da Variável {{3}}"/>
                                    </group>
                                </div>
                                <div class="col-md-5">
                                    <div class="o_whatsapp_preview_box" style="padding: 10px; border-left: 1px solid #dee2e6;">
                                        <h5 class="text-center text-muted"><i class="fa fa-mobile"/> Visualização do Cliente</h5>
                                        <div style="display: flex; justify-content: center;">
                                            <field name="whatsapp_preview_html" widget="html" readonly="1" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="Rastreamento Individual (Traces)" name="traces">
                            <field name="mailing_trace_ids" readonly="1">
                                <list decoration-muted="whatsapp_status == 'outgoing'" decoration-info="whatsapp_status == 'sent'" decoration-success="whatsapp_status in ['delivered', 'read']" decoration-danger="whatsapp_status in ['failed', 'canceled']">
                                    <field name="whatsapp_recipient_number"/>
                                    <field name="whatsapp_status" widget="badge"/>
                                    <field name="whatsapp_sent_date"/>
                                    <field name="whatsapp_delivered_date"/>
                                    <field name="whatsapp_read_date"/>
                                    <field name="whatsapp_error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- WhatsApp Mailing Kanban View -->
    <record id="view_mailing_mailing_whatsapp_kanban" model="ir.ui.view">
        <field name="name">mailing.mailing.whatsapp.kanban</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="subject"/>
                <field name="state"/>
                <field name="total"/>
                <field name="whatsapp_delivered_count"/>
                <field name="whatsapp_read_count"/>
                <field name="whatsapp_failed_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb8">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="subject"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-users text-muted"/> Destinatários: <field name="total"/></div>
                                <div><i class="fa fa-check text-success"/> Entregues: <field name="whatsapp_delivered_count"/></div>
                                <div><i class="fa fa-eye text-primary"/> Lidos: <field name="whatsapp_read_count"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt8">
                                <div class="oe_kanban_bottom_left">
                                    <field name="whatsapp_account_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="schedule_date" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for WhatsApp Mailings -->
    <record id="action_mailing_mailing_whatsapp" model="ir.actions.act_window">
        <field name="name">Campanhas de WhatsApp</field>
        <field name="res_model">mailing.mailing</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('mailing_type', '=', 'whatsapp')]</field>
        <field name="context">{
            'default_mailing_type': 'whatsapp',
            'default_mailing_model_id': ref('mass_mailing.model_mailing_list', raise_if_not_found=False),
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie sua primeira campanha de WhatsApp Marketing!
            </p>
            <p>
                Dispare textos, promoções e imagens para milhares de contatos importados de planilhas ou da sua base CRM respeitando os limites da Meta.
            </p>
        </field>
    </record>

    <!-- View Modes Assignment -->
    <record id="action_mailing_mailing_whatsapp_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_mailing_mailing_whatsapp_kanban"/>
        <field name="act_window_id" ref="action_mailing_mailing_whatsapp"/>
    </record>

    <record id="action_mailing_mailing_whatsapp_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mailing_mailing_whatsapp_form"/>
        <field name="act_window_id" ref="action_mailing_mailing_whatsapp"/>
    </record>
</odoo>
